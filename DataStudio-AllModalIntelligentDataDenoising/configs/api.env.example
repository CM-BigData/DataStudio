LLM_API_BASE=https://your-openai-compatible-host/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-chat-model
LLM_CHAT_COMPLETIONS_PATH=/chat/completions

VLM_API_BASE=https://your-openai-compatible-host/v1
VLM_API_KEY=replace-with-your-key
VLM_MODEL=replace-with-your-vision-model
VLM_CHAT_COMPLETIONS_PATH=/chat/completions

OCR_API_BASE=https://your-openai-compatible-host/v1
OCR_API_KEY=replace-with-your-key
OCR_MODEL=replace-with-your-vision-ocr-model
OCR_CHAT_COMPLETIONS_PATH=/chat/completions

CLIP_API_BASE=https://your-openai-compatible-host/v1
CLIP_API_KEY=replace-with-your-key
CLIP_MODEL=replace-with-your-image-text-model
CLIP_CHAT_COMPLETIONS_PATH=/chat/completions

# Optional. Video ASR requires a real audio transcription endpoint/model.
ASR_API_BASE=https://your-audio-api-host/v1
ASR_API_KEY=replace-with-your-key
ASR_MODEL=replace-with-your-asr-model
ASR_TRANSCRIPTIONS_PATH=/audio/transcriptions
